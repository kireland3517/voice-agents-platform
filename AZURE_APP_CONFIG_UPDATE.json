{
  "senior-life/audio-settings": {
    "voice-rate": "0.95",
    "voice-pitch": "+0%",
    "voice-volume": "+0%",
    "voice-temperature": 0.85,
    "vad-threshold": 0.35,
    "vad-prefix-padding-ms": 400,
    "vad-silence-duration-ms": 600,
    "vad-end-utterance-timeout-ms": 1500,
