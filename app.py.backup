# FASTAPI
# ──────────────────────────────────────────────────────────────────────────────
app = FastAPI(title="Senior Life Voice Agent Bridge")

@app.get("/")
def root():
    return {
        "ok": True,
        "service": "Senior Life Insurance voice agent",
        "version": "12.2 - Fixed",
        "api": "Azure OpenAI Realtime API",
        "model": AZURE_AI_MODEL,
        "audio_format": "PCM16 24kHz passthrough",
        "features": [
            "Server-side VAD",
            "Native audio streaming",
            "OpenAI voices",
            "Greeting protected (no barge-in)",
            "Clean barge-in on later turns",
            "Half-duplex cancel on caller speech",
            "Blob recordings / transcripts" if SAVE_RECORDINGS or SAVE_TRANSCRIPTS else None
        ]
    }

@app.get("/healthz")
def healthz():
    return JSONResponse({"ok": True, "status": "healthy"})

@app.get("/companies/{company_id}/config")
def get_company_config(company_id: str):
    try:
        config = config_manager.get_company_config(company_id)
        if not config or not config.get('company-name'):
            raise HTTPException(status_code=404, detail=f"Company '{company_id}' not found")
        return {"company_id": company_id, "config": config}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/companies/{company_id}/audio-settings")
def get_company_audio_settings(company_id: str):
    try:
        settings = config_manager.get_audio_settings(company_id)
        return {"company_id": company_id, "audio_settings": settings}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# ──────────────────────────────────────────────────────────────────────────────
# WS BRIDGE
# ──────────────────────────────────────────────────────────────────────────────
@app.websocket("/voice/{company_id}")
async def voice_bridge(company_id: str, signalwire_ws: WebSocket):
    await signalwire_ws.accept()
    logger.info(f"✅ SignalWire connection accepted for company: {company_id}")

    try:
        company_config = config_manager.get_company_config(company_id)
        if not company_config or not company_config.get('company-name'):
            msg = f"Company '{company_id}' not found in configuration"
            logger.error(msg)
            await signalwire_ws.send_text(json.dumps({"type": "error", "source": "config", "detail": msg}))
            await signalwire_ws.close(code=1008)
            return
        company_name = company_config['company-name']
        audio_settings = company_config.get('audio-settings', {})
        logger.info(f"✅ Loaded config for {company_name}")
    except Exception as e:
        msg = f"Failed to load company configuration: {e}"
        logger.error(msg)
        await signalwire_ws.send_text(json.dumps({"type": "error", "source": "config", "detail": msg}))
        await signalwire_ws.close(code=1011)
        return

    azure_ws = None
    call_session: Optional[CallSession] = None
    stream_sid: Optional[str] = None

    shared_state: Dict[str, Any] = {"call_session": None, "stream_sid": None}

    try:
        instructions, voice_name, greeting_text = build_company_instructions(company_config)
        azure_ws = await create_azure_websocket_connection(instructions, voice_name, audio_settings, greeting_text)
        logger.info(f"✅ Azure OpenAI Realtime connection established for {company_name}")

        audio_sender_task = asyncio.create_task(
            send_signalwire_audio_to_azure(signalwire_ws, azure_ws, company_id, company_name, shared_state)
        )
        logger.info(f"🎙️ {company_name} agent ready for calls!")

        try:
            async for message in azure_ws:
                try:
                    event = json.loads(message)

                    if not call_session:
                        call_session = shared_state.get("call_session")
                        stream_sid = shared_state.get("stream_sid")

                    await handle_azure_event(event, signalwire_ws, company_name, stream_sid, call_session)
                except json.JSONDecodeError as e:
                    logger.error(f"Failed to parse Azure message: {e}")
                except Exception as e:
                    logger.error(f"Error handling Azure event: {e}")
                    logger.error(traceback.format_exc())
        except websockets.exceptions.ConnectionClosed:
            logger.info(f"Azure WebSocket connection closed for {company_name}")
        finally:
            audio_sender_task.cancel()
            try:
                await audio_sender_task
            except asyncio.CancelledError:
                pass

    except Exception as e:
        msg = f"Azure connection failed: {e}"
        logger.error(msg)
        logger.error(traceback.format_exc())
        if signalwire_ws.application_state == WebSocketState.CONNECTED:
            await signalwire_ws.send_text(json.dumps({"type": "error", "source": "azure", "detail": str(e)}))
            await signalwire_ws.close(code=1011)
    finally:
        if azure_ws:
            await azure_ws.close()

# ──────────────────────────────────────────────────────────────────────────────
# AZURE → SIGNALWIRE EVENT HANDLER
# supports response.audio.delta (and output_… variant)
# enforces: no barge-in during greeting; cancel on caller speech post-greeting
# ──────────────────────────────────────────────────────────────────────────────
AUDIO_DELTA_EVENTS = {"response.audio.delta", "response.output_audio.delta"}
AUDIO_DONE_EVENTS  = {"response.audio.done", "response.output_audio.done"}
ASR_DELTA_EVENTS   = {"response.audio_transcript.delta", "response.output_audio_transcript.delta"}
ASR_DONE_EVENTS    = {"response.audio_transcript.done", "response.output_audio_transcript.done"}

async def handle_azure_event(
    event: Dict[str, Any],
    signalwire_ws: WebSocket,
    company_name: str,
    stream_sid: Optional[str],
    call_session: Optional[CallSession]
):
    et = event.get("type", "")

    if et == "session.updated":
        logger.info(f"✅ {company_name} Realtime session ready")

    elif et == "input_audio_buffer.speech_started":
        logger.info("🎤 Caller started speaking")
        # Half-duplex: if assistant is speaking AND greeting already done, cancel
        if call_session and call_session.azure_ws and call_session.azure_is_speaking and call_session.greeting_done:
            try:
                # Try to clear SignalWire's playout buffer (best-effort)
                if signalwire_ws.application_state == WebSocketState.CONNECTED:
                    await signalwire_ws.send_text(json.dumps({"event": "clear"}))
                
                # Cancel Azure's response
                await call_session.azure_ws.send(json.dumps({"type": "response.cancel"}))
                call_session.azure_is_speaking = False
                logger.info("🛑 Barge-in: cancelled assistant turn on caller speech")
            except Exception as e:
                logger.error(f"Failed to cancel on speech_started: {e}")

    elif et == "input_audio_buffer.speech_stopped":
        logger.info("🎤 Caller stopped speaking")

    elif et == "conversation.item.input_audio_transcription.completed":
        if SAVE_TRANSCRIPTS and call_session:
            t = event.get("transcript", "")
            if t:
                call_session.add_transcript_entry("caller", t)
                logger.info(f"📝 Caller: {t}")

    elif et == "response.created":
        if call_session:
            call_session.azure_is_speaking = True
            call_session.azure_started_audio = False
            call_session.current_response_id = (event.get("response") or {}).get("id")
        logger.info("🤖 Assistant responding")

    elif et in AUDIO_DELTA_EVENTS:
        if signalwire_ws.application_state != WebSocketState.CONNECTED:
            return
        b64 = event.get("delta")
        if not b64:
            return

        if call_session and not call_session.azure_started_audio:
            call_session.azure_started_audio = True

        if call_session and SAVE_RECORDINGS:
            try:
                call_session.add_ai_audio(b64)
            except Exception:
                pass

        await signalwire_ws.send_text(json.dumps({
            "event": "media",
            "streamSid": stream_sid or "",
            "media": {"payload": b64}
        }))

    elif et in ASR_DELTA_EVENTS:
        # noisy; omit
        pass

    elif et in ASR_DONE_EVENTS:
        if SAVE_TRANSCRIPTS and call_session:
            t = event.get("transcript", "")
            if t:
                call_session.add_transcript_entry("ai", t)
                logger.info(f"📝 AI: {t}")

    elif et in AUDIO_DONE_EVENTS:
        if call_session:
            call_session.azure_is_speaking = False
        logger.info(f"🎵 {company_name} finished speaking")

    elif et == "response.done":
        # Greeting completes on the very first response.done
        if call_session and not call_session.greeting_done:
            call_session.greeting_done = True
            logger.info("📣 Greeting completed; barge-in now enabled")
        logger.info("✅ Response complete")

    elif et == "error":
        msg = (event.get("error") or {}).get("message", "Unknown error")
        logger.error(f"❌ Azure error: {msg}")
        if signalwire_ws.application_state == WebSocketState.CONNECTED:
            await signalwire_ws.send_text(json.dumps({"type": "error", "source": "azure", "detail": msg}))

# ──────────────────────────────────────────────────────────────────────────────
# SIGNALWIRE → AZURE
# Forwards caller PCM16 frames; recording optional; no manual commit (server VAD)
# ──────────────────────────────────────────────────────────────────────────────
async def send_signalwire_audio_to_azure(
    signalwire_ws: WebSocket,
    azure_ws,
    company_id: str,
    company_name: str,
    shared_state: Dict[str, Any]
):
    logger.info(f"🎤 Audio forwarding started for {company_name}")

    stream_sid: Optional[str] = None
    call_session: Optional[CallSession] = None

    try:
        while True:
            msg = await signalwire_ws.receive()

            if msg["type"] == "websocket.disconnect":
                logger.info(f"📞 SignalWire disconnected for {company_name}")
                break

            if "text" in msg and msg["text"] is not None:
                try:
                    data = json.loads(msg["text"])
                    evt = data.get("event")

                    if evt == "connected":
                        logger.info(f"🔗 SignalWire connected for {company_name}")

                    elif evt == "start":
                        stream_sid = (data.get("start") or {}).get("streamSid")
                        caller_phone = (data.get("start") or {}).get("from")
                        media_format = (data.get("start") or {}).get("mediaFormat", {})

                        # Create CallSession with azure_ws reference
                        call_session = CallSession(company_id, stream_sid or "unknown", azure_ws)
                        shared_state["call_session"] = call_session
                        shared_state["stream_sid"] = stream_sid

                        logger.info(f"▶️ Call started for {company_name}")
                        logger.info(f"📞 Caller ID: {caller_phone}")
                        logger.info(f"📊 Audio format: {media_format}")
                        logger.info(f"📞 Call SID: {stream_sid}")

                        # time/business-hours context
                        eastern = pytz.timezone('US/Eastern')
                        now_e = datetime.now(eastern)
                        is_business_hours = (
                            now_e.weekday() < 5 and
                            (now_e.hour > 8 or (now_e.hour == 8 and now_e.minute >= 30)) and
                            now_e.hour < 17
                        )
                        formatted_phone = caller_phone or "Unknown"
                        if caller_phone and len(caller_phone) == 12 and caller_phone.startswith('+1'):
                            formatted_phone = f"{caller_phone[:2]}-{caller_phone[2:5]}-{caller_phone[5:8]}-{caller_phone[8:]}"

                        context_message = {
                            "type": "conversation.item.create",
                            "item": {
                                "type": "message",
                                "role": "system",
                                "content": [{
                                    "type": "input_text",
                                    "text": (
                                        f"Date: {now_e.strftime('%B %d, %Y')}\n"
                                        f"Day: {now_e.strftime('%A')}\n"
                                        f"Time: {now_e.strftime('%I:%M %p')} Eastern\n"
                                        f"{'Agents available now for warm transfer' if is_business_hours else 'Outside business hours; schedule callback'}\n"
                                        f"CallerID: {formatted_phone}\n"
                                        "When collecting a callback number, confirm the caller ID when appropriate."
                                    )
                                }]
                            }
                        }
                        await azure_ws.send(json.dumps(context_message))
                        logger.info("✅ Sent call context to model")

                        if media_format.get("encoding") != "audio/x-L16":
                            logger.warning(f"⚠️ Expected L16 encoding, got: {media_format.get('encoding')}")
                        if media_format.get("sampleRate") != 24000:
                            logger.warning(f"⚠️ Expected 24000Hz, got: {media_format.get('sampleRate')}")

                    elif evt == "media":
                        if not call_session:
                            continue
                        payload = (data.get("media") or {}).get("payload")
                        if not payload:
                            continue

                        if SAVE_RECORDINGS:
                            call_session.add_caller_audio(payload)

                        # Optional: cancel mid-turn on media arrival AFTER greeting
                        if call_session.azure_ws and call_session.azure_is_speaking and call_session.greeting_done:
                            try:
                                await call_session.azure_ws.send(json.dumps({"type": "response.cancel"}))
                                call_session.azure_is_speaking = False
                                logger.info("🛑 Barge-in (media): cancelled assistant turn")
                            except Exception as e:
                                logger.error(f"Failed to cancel on media: {e}")

                        await azure_ws.send(json.dumps({
                            "type": "input_audio_buffer.append",
                            "audio": payload
                        }))
                        # server_vad handles turn segmentation

                    elif evt == "stop":
                        logger.info(f"⏹️ Call ended for {company_name}")
                        if call_session:
                            try:
                                call_session.finalize()
                                await call_session.save_to_storage()
                                logger.info("✅ Call session saved successfully")
                            except Exception as e:
                                logger.error(f"Failed to save call session: {e}")
                                logger.error(traceback.format_exc())
                        break

                except json.JSONDecodeError as e:
                    logger.error(f"JSON decode error: {e}")
                except Exception as e:
                    logger.error(f"Error processing SignalWire message: {e}")
                    logger.error(traceback.format_exc())

    except asyncio.CancelledError:
        logger.info(f"🛑 Audio forwarding cancelled for {company_name}")
    except WebSocketDisconnect:
        logger.info(f"📞 WebSocket disconnected for {company_name}")
    except Exception as e:
        logger.error(f"❌ Error in audio forwarding for {company_name}: {e}")
        logger.error(traceback.format_exc())
    finally:
        logger.info(f"🛑 Audio forwarding stopped for {company_name}")

# ──────────────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)